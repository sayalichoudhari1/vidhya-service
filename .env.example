#
# Local development environment for running the Vidhya Service Go binary
# directly on your host (go run ./src or the compiled binary), talking to
# Postgres/Redis started via `make local-up` (devops/local/docker-compose.yml).
#
# Copy this file to `.env` in the repo root and `source .env` (or use
# `make run`, which sources it for you) before starting the service.
#
# This file is NOT used in production. In AWS these same variable names are
# injected by the ECS task definition (see aws.cfn.app.yml) sourced from
# SSM Parameter Store / Secrets Manager.
#

# ------------------------------------------------------------- server-configs --
export APP_SERVER_ADDRESS=:8080
export APP_SERVER_URL_PREFIX=/vidhyaservice
export APP_SERVER_ALLOWED_ORIGINS=*

# ------------------------------------------------------------- db-configs -----
# Postgres container started by devops/local/docker-compose.yml publishes
# on host port 55432 (remapped from the container's internal 5432 to avoid
# clashing with any other local Postgres you already have on 5432).
export DB_HOST=localhost
export DB_PORT=55432
export DB_USER=appuser
export DB_PASS=appuser
export DB_NAME=vidhyadb
export DB_SSLMODE=disable

# ------------------------------------------------------------- jwt-configs ----
# CHANGE THIS in every real environment; local default is fine for dev only.
export JWT_SECRET=please-change-this-secret-in-every-environment
export JWT_ACCESS_TOKEN_DURATION=2h
export JWT_REFRESH_TOKEN_DURATION=168h
export JWT_ISSUER=vidhya-service

# ------------------------------------------------------------- redis-configs --
# Optional. Leave disabled for phase 1 (no code path requires it yet).
# Redis, if started via `make local-up`, is published on host port 63790.
export REDIS_ENABLED=false
export REDIS_ADDRESS=localhost:63790
export REDIS_PASSWORD=
export REDIS_DB=0

# ------------------------------------------------------------- kafka-configs --
# Optional. Leave disabled for phase 1 (no code path requires it yet).
# Kafka is behind the "kafka" compose profile; if started, it publishes on
# host port 19092 (see devops/local/docker-compose.yml).
export KAFKA_ENABLED=false
export KAFKA_BROKERS=localhost:19092

# ------------------------------------------------------------- log-configs ----
export LOG_LEVEL=DEBUG
export LOG_FORMAT=TEXT

# ------------------------------------------------------------- seed-configs ---
# On a brand-new database, creates a default ADMIN user so you can log in
# immediately without a manual SQL insert. Safe to leave on; it is a no-op
# once the admin user already exists.
export SEED_ADMIN_ENABLED=true
export SEED_ADMIN_EMAIL=admin@vidhya.local
export SEED_ADMIN_PASSWORD=Admin@123
export SEED_ADMIN_PHONE=+10000000000
