<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Ordered by filename (001, 002, ...) so foreign keys always follow their
         referenced tables. See changelogs/ for individual changesets. -->
    <includeAll path="changelogs" relativeToChangelogFile="true" errorIfMissingOrEmpty="true"/>

</databaseChangeLog>
