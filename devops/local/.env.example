#
# Local development environment for Vidhya Service docker-compose services
# (postgres, liquibase, redis). Copy this file to `.env` in this same folder.
# It is NOT used in production; production config comes from AWS
# SSM/Secrets Manager via aws.cfn.app.yml.
#
# NOTE: DB_HOST/DB_PORT/DB_NAME are intentionally NOT set here. Inside the
# docker network the postgres/liquibase Dockerfiles already default
# DB_HOST=postgres, DB_PORT=5432, DB_NAME=vidhyadb so the containers can
# reach each other by service name. To run the Go service itself (outside
# docker, on your host) use the repo-root `.env.example` instead, which
# points DB_HOST at localhost (the published port below).
#

# --------------------------------------------------------------- db-configs ---
# Used by docker-compose to initialize the local Postgres container and by
# Liquibase to connect and apply migrations (sql/changelogs).
DB_MASTER_USER=appuser
DB_MASTER_PASS=appuser

DB_USER=appuser
DB_PASS=appuser
